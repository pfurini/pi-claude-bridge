CLAUDE_BRIDGE_TESTING_ALT_PROVIDER=openai-codex
CLAUDE_BRIDGE_TESTING_ALT_MODEL=gpt-5.6-terra
# Upstream's alternative, kept for reference. Must tolerate reasoning being
# disabled: pi sends reasoning effort "none" when thinking is off, and a growing
# number of OpenRouter endpoints reject that outright (minimax/minimax-m2.5 and
# google/gemini-3.6-flash both 400 on it).
# CLAUDE_BRIDGE_TESTING_ALT_PROVIDER=openrouter
# CLAUDE_BRIDGE_TESTING_ALT_MODEL=google/gemini-2.5-flash

# The profile the integration tests run Claude Code under. Tests that take their
# config dir from the environment (int-cc-contracts, int-session-rebuild,
# int-attachment-rebuild and the compact/session families) otherwise fall through
# to ~/.claude, which is a different profile from the one the bridge itself uses:
# defaultClaudeConfigDir() is hardcoded to ~/.pi/agent/claude, and that is also
# what test:auth-preflight checks. Leaving this unset means the preflight passes
# against an authenticated profile while those tests fail on an unauthenticated
# one, reported as "OAuth session expired and could not be refreshed".
#
# Must be an absolute literal path. `npm test` and tests/lib/bash-setup.sh source
# this file through bash, which would expand $HOME or ~, but tests/lib/
# rpc-harness.mjs loads it with process.loadEnvFile(), which performs no
# expansion at all — so either form would leave every int-*.mjs test resolving a
# directory literally named "$HOME" while the bash suites got the real one.
CLAUDE_CONFIG_DIR=/Users/paolof/.pi/agent/claude
