{
  "name": "pi-claude-bridge",
  "version": "0.9.0",
  "private": false,
  "description": "Pi extension that uses Claude Code (via Agent SDK) as a model provider.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "claude-code",
    "claude-agent-sdk"
  ],
  "author": "Eli Dickinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elidickinson/pi-claude-bridge.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "test:unit": "node --import tsx --import ./tests/lib/setup.mjs --test tests/unit-*.mjs",
    "test:auth-preflight": "node --import tsx tests/lib/claude-auth.mjs",
    "test": "set -a; if [ -f .env.test ]; then . ./.env.test || exit 1; fi; set +a; CLAUDE_BRIDGE_TEST_LOG_DIR=$(mktemp -d) || exit 1; export CLAUDE_BRIDGE_TEST_LOG_DIR; npm run test:unit && npm run test:auth-preflight && tests/int-smoke.sh && tests/int-multi-turn.sh && tests/int-cache.sh && node --import tsx --test tests/int-*.mjs && node tests/lib/check-deadlock-logs.mjs \"$CLAUDE_BRIDGE_TEST_LOG_DIR\" && node diag/gate-warnings.mjs \"$CLAUDE_BRIDGE_TEST_LOG_DIR\"",
    "test:usage": "tests/usage-test.sh",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@modelcontextprotocol/sdk": "1.29.0",
    "cc-session-io": "^0.4.0",
    "change-case": "^5.4.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.1",
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "@earendil-works/pi-tui": ">=0.86.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@earendil-works/pi-ai": "file:../pi/packages/ai",
    "@earendil-works/pi-coding-agent": "file:../pi/packages/coding-agent",
    "@earendil-works/pi-tui": "file:../pi/packages/tui",
    "@types/node": "^24.13.2",
    "tsx": "^4.22.4",
    "typebox": "^1.3.7",
    "typescript": "^6.0.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
